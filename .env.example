# Copie este arquivo para ".env" (mesma pasta) e preencha os valores.
# O ".env" NUNCA é commitado (veja .gitignore) — cada dev/máquina tem o seu.

# ---- Banco de dados (Postgres em Docker) ----
DB_NAME=askia_db
DB_USER=askia
DB_PASSWORD=askia123

# ---- Frontend ----
# URL pública onde o frontend roda (usada no CORS do backend e no link do
# e-mail de redefinição de senha).
FRONTEND_URL=http://localhost:4200

# ---- IA: OpenAI OU Gemini (escolha automática — não precisa indicar qual) ----
# Preencha a key de QUALQUER UM dos dois (nunca precisa dos dois). O backend
# detecta sozinho: se só GEMINI_API_KEY estiver preenchida, usa Gemini; em
# qualquer outro caso (só OpenAI, as duas, ou nenhuma), usa OpenAI.
#
# OpenAI: pegue em https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini: pegue em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Resend (e-mails de "esqueci minha senha") ----
# Pegue em https://resend.com/api-keys
RESEND_API_KEY=
# Sem domínio verificado na Resend, use onboarding@resend.dev (só entrega
# para o e-mail da sua própria conta Resend, mas funciona pra demo/TCC).
RESEND_FROM_EMAIL=onboarding@resend.dev

# true só em produção, atrás de HTTPS (ver comentário em application.properties)
COOKIE_SECURE=false
