# Copie este arquivo para ".env" (mesma pasta) e preencha os valores.
# O ".env" NUNCA é commitado (veja .gitignore) — cada dev/máquina tem o seu.

# ---- Banco de dados (Postgres em Docker) ----
DB_NAME=askia_db
DB_USER=askia
DB_PASSWORD=askia123

# ---- Frontend ----
# URL pública onde o frontend roda (usada no CORS do backend e no link do
# e-mail de redefinição de senha).
FRONTEND_URL=http://localhost:4200

# ---- IA: Groq (decisão da equipe em 10/11/2026) ----
# O Groq usa o mesmo formato da OpenAI, por isso as variáveis se chamam OPENAI_*.
# 1. Crie sua chave em https://console.groq.com/keys (cada integrante usa a sua).
# 2. Cole a chave (começa com gsk_) em OPENAI_API_KEY. O resto já está pronto.
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Reserva paga (OpenAI): chave da OpenAI em OPENAI_API_KEY, um modelo da OpenAI
# em OPENAI_MODEL e OPENAI_BASE_URL vazio.
#
# Gemini: só para teste interno da equipe, com texto de exemplo (os termos do
# Gemini proíbem apps usados por menores de 18). Só é usado se OPENAI_API_KEY
# estiver vazia. Em conta nova do plano gratuito, use gemini-3.5-flash-lite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Resend (e-mails de "esqueci minha senha") ----
# Pegue em https://resend.com/api-keys
RESEND_API_KEY=
# Sem domínio verificado na Resend, use onboarding@resend.dev (só entrega
# para o e-mail da sua própria conta Resend, mas funciona pra demo/TCC).
RESEND_FROM_EMAIL=onboarding@resend.dev

# true só em produção, atrás de HTTPS (ver comentário em application.properties)
COOKIE_SECURE=false
